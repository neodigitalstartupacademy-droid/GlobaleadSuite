{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoachJoseRecommendation",
  "type": "object",
  "required": ["analysis", "causes", "products", "dosage", "advice", "cta"],
  "properties": {
    "analysis": { "type": "string", "minLength": 1 },
    "causes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "priority"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "priority": { "type": "string", "enum": ["essential", "recommended", "optional"] }
        },
        "additionalProperties": false
      },
      "contains": {
        "type": "object",
        "properties": {
          "id": { "const": "tre-en-en" }
        },
        "required": ["id"]
      }
    },
    "dosage": {
      "type": "object",
      "required": ["morning", "afternoon", "evening"],
      "properties": {
        "morning": { "type": "array", "items": { "type": "string" } },
        "afternoon": { "type": "array", "items": { "type": "string" } },
        "evening": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "advice": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cta": {
      "type": "string",
      "pattern": "WhatsApp"
    }
  },
  "additionalProperties": false
}
